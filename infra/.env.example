# Copy to infra/.env (gitignored) for local synth, diff, and deploy. CI uses repo variables instead.
# Only the CDK app reads this file. Set AWS_PROFILE in your shell, because the cdk CLI reads it.
BUDGET_ALERT_EMAIL=you@example.com
# Optional custom domain (D-019). Set both or neither.
# SITE_DOMAIN=example.com
# HOSTED_ZONE_ID=Z0123456789ABCDEFGHIJ
